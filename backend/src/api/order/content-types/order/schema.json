{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Commande",
    "description": "Commandes clients (créées uniquement par le serveur)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "orderNumber": { "type": "string", "required": true, "unique": true },
    "customerEmail": { "type": "email", "required": true },
    "customerName": { "type": "string" },
    "items": { "type": "json", "required": true },
    "subtotal": { "type": "decimal", "required": true },
    "shipping": { "type": "decimal", "default": 0 },
    "total": { "type": "decimal", "required": true },
    "currency": { "type": "string", "default": "eur" },
    "paymentStatus": {
      "type": "enumeration",
      "enum": ["pending", "paid", "failed", "cancelled"],
      "default": "pending",
      "required": true
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": ["processing", "shipped", "delivered", "cancelled"],
      "default": "processing",
      "required": true
    },
    "stockDecremented": { "type": "boolean", "default": false, "private": true },
    "stripeSessionId": { "type": "string", "private": true },
    "stripePaymentIntentId": { "type": "string", "private": true },
    "shippingAddress": { "type": "json" },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
